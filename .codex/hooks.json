{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'r=$(git rev-parse --show-toplevel 2>/dev/null || echo .); python3 \"$r/scripts/jev/prompt_gate.py\" --for=codex || exit 0'",
            "timeout": 8,
            "statusMessage": "Checking with Jev"
          }
        ]
      }
    ]
  }
}
