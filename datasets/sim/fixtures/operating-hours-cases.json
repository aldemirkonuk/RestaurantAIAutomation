{
  "_contract": {
    "version": 1,
    "shape": "restaurants.operating_hours: {mon..sun: [{open:'HH:MM', close:'HH:MM'}]} — all seven keys required; [] = closed that day; up to 3 ranges per day; close <= open means the range crosses midnight into the next local day; interpreted in restaurants.timezone (IANA)",
    "resolution_rule": "A local wall time resolves to an instant the way Python's zoneinfo does with fold=0: among the instants whose local wall time equals the target (there are two in a DST fall-back hour), take the EARLIEST — the first occurrence; if there is none (the wall time falls in a DST spring-forward gap), use the offset in force just BEFORE the transition. Implementations must find candidates from the offsets on both sides of the target (bracket the day before and after), not from a single guess: anchoring on offset(guess-read-as-UTC) is only right west of Greenwich and inverts both rules east of it (Europe/Berlin, Australia/Sydney) — measured 2026-09-02 over 630,720 wall times in 12 zones. The Berlin and Sydney cases below pin this in both suites.",
    "is_open_at": "returns open=null with a reason when hours or timezone are unknown — never false. A window that opened on the previous local day and runs past midnight still counts.",
    "service_windows": "windows whose OPEN falls on the given local date, as [start, end] UTC instants, sorted by start"
  },
