# ============================================================================
# WineOps AI - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ============================================================================
# DATABASE (Supabase)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# MESSAGE QUEUE (RabbitMQ - CloudAMQP)
# ============================================================================
RABBITMQ_URL=amqps://username:password@rabbit.cloudamqp.com/vhost

# ============================================================================
# AI SERVICES
# ============================================================================
GOOGLE_API_KEY=your-gemini-api-key

# ============================================================================
# EMAIL (Gmail API)
# ============================================================================
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_SENDER_EMAIL=notifications@wineops.ai

# ============================================================================
# SMS (Plivo)
# ============================================================================
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_PHONE_NUMBER=+1234567890

# ============================================================================
# MANAGER NOTIFICATIONS
# ============================================================================
# Comma-separated. Leave unset to disable manager fallbacks and scheduled alerts to a default inbox.
MANAGER_EMAIL=
MANAGER_PHONE=+1234567890
DEFAULT_RESTAURANT_ID=your-default-restaurant-id

# ============================================================================
# POS INTEGRATION (Toast)
# ============================================================================
TOAST_API_URL=https://ws-api.toasttab.com
TOAST_CLIENT_ID=your-toast-client-id
TOAST_CLIENT_SECRET=your-toast-client-secret
TOAST_RESTAURANT_GUID=your-restaurant-guid
TOAST_WEBHOOK_SECRET=your-webhook-secret
TOAST_ENVIRONMENT=sandbox
MOCK_POS=true

# ============================================================================
# AUTHENTICATION (OAuth)
# ============================================================================
# Google OAuth (for user login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback

# Microsoft OAuth (for user login)
MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/microsoft/callback

# ============================================================================
# THIRD-PARTY INTEGRATION GRANTS (Drive / Excel)
# ============================================================================
# Separate from the login flow above: these are delegated API grants that carry
# refresh tokens, so the tokens are encrypted at rest before hitting Postgres.
# 32 bytes, hex or base64. Generate with: openssl rand -hex 32
# Leave unset to disable the integration connect buttons entirely.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Public origin of the API gateway; used to build the OAuth redirect_uri that
# must also be registered in the Google/Azure app console.
API_PUBLIC_URL=http://localhost:4000
# Override only if the registered redirect_uri differs from the derived default
# (API_PUBLIC_URL + /api/v1/integrations/oauth/<provider>/callback)
# GOOGLE_INTEGRATION_CALLBACK_URL=
# MICROSOFT_INTEGRATION_CALLBACK_URL=

# ============================================================================
# FRONTEND
# ============================================================================
VITE_API_URL=http://localhost:4000
VITE_API_GATEWAY_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
# Same OAuth client as GOOGLE_CLIENT_ID above — client IDs are not secret and
# are always exposed browser-side by Google Identity Services (GSI) buttons.
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
VITE_SENTRY_DSN=
VITE_APP_VERSION=2.6.0
# Optional — only if you call scheduleTestEmail(); never hardcode a real inbox in repo defaults
# VITE_SCHEDULED_TEST_EMAIL=

# ============================================================================
# API GATEWAY
# ============================================================================
NODE_ENV=development
PORT=4000
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

# ============================================================================
# AGENT ORCHESTRATOR
# ============================================================================
AGENT_PORT=8000
BUFFER_WINDOW_MINUTES=30
DEFAULT_THRESHOLD_MIN=3

# ============================================================================
# GMAIL INBOUND EMAIL (Push Notifications via Pub/Sub)
# ============================================================================
# Required for receiving vendor email replies in real-time
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-notifications
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-gcp-project/subscriptions/gmail-push
GMAIL_WATCH_LABEL_IDS=INBOX

# ============================================================================
# MONITORING
# ============================================================================
LOG_LEVEL=debug
DEBUG=true

# ============================================================================
# YOLO PREVIEW MODEL
# ============================================================================
YOLO_MODEL_PATH=datasets/wine_menus_2class/runs/train2/weights/best.pt

# ============================================================
# Phase 21: Golden Path E2E — Agent Orchestration
# ============================================================

# RabbitMQ connection
# Use a full URL OR individual components — Settings prefers RABBITMQ_URL if set
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Application environment
ENVIRONMENT=development

# Inventory / BufferManager configuration
EVALUATION_INTERVAL_SECONDS=60
# Fraction of max stock below which threshold breach fires (0.2 = 20%)
NOTIFICATION_THRESHOLD_PCT=0.2

# LLM routing defaults
LLM_PRIMARY_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.1

# Notification backends
EMAIL_BACKEND=gmail
FROM_EMAIL=alerts@yourdomain.com
SENDGRID_API_KEY=your_sendgrid_api_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_EMAIL=mailto:admin@yourdomain.com
FCM_SERVER_KEY=your_fcm_server_key
# Set MOCK_NOTIFICATIONS=false only when real notification credentials are configured
MOCK_NOTIFICATIONS=true

# ============================================================================
# PHASE 37 — SYNTHETIC RESTAURANT PERSONAS (D-17..D-19)
# ============================================================================
# Three DISTINCT Auth users for sim-* role isolation. Never commit real values.
# Used by scripts/synth/auth_personas.py (seed/teardown). Auth users are durable.
SIM_OWNER_EMAIL=sim-owner@wineops.internal
SIM_OWNER_PASSWORD=replace-me-owner
SIM_MANAGER_EMAIL=sim-manager@wineops.internal
SIM_MANAGER_PASSWORD=replace-me-manager
SIM_STAFF_EMAIL=sim-staff@wineops.internal
SIM_STAFF_PASSWORD=replace-me-staff
# Optional direct Postgres DSN for secondary TX path (prefer seed_sim_restaurant RPC)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
