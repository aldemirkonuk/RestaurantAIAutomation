# ============================================================================
# WineOps AI - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ============================================================================
# DATABASE (Supabase)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# MESSAGE QUEUE (RabbitMQ - CloudAMQP)
# ============================================================================
RABBITMQ_URL=amqps://username:password@rabbit.cloudamqp.com/vhost

# ============================================================================
# AI SERVICES
# ============================================================================
GOOGLE_API_KEY=your-gemini-api-key

# ============================================================================
# EMAIL (Gmail API)
# ============================================================================
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_SENDER_EMAIL=notifications@wineops.ai

# ============================================================================
# SMS (Plivo)
# ============================================================================
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_PHONE_NUMBER=+1234567890

# ============================================================================
# MANAGER NOTIFICATIONS
# ============================================================================
MANAGER_EMAIL=aldemirkonuk2004@gmail.com
MANAGER_PHONE=+1234567890
DEFAULT_RESTAURANT_ID=your-default-restaurant-id

# ============================================================================
# POS INTEGRATION (Toast)
# ============================================================================
TOAST_API_URL=https://ws-api.toasttab.com
TOAST_CLIENT_ID=your-toast-client-id
TOAST_CLIENT_SECRET=your-toast-client-secret
TOAST_RESTAURANT_GUID=your-restaurant-guid
TOAST_WEBHOOK_SECRET=your-webhook-secret
TOAST_ENVIRONMENT=sandbox
MOCK_POS=true

# ============================================================================
# AUTHENTICATION (OAuth)
# ============================================================================
# Google OAuth (for user login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback

# Microsoft OAuth (for user login)
MICROSOFT_CLIENT_ID=your-microsoft-oauth-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-oauth-client-secret
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/microsoft/callback

# ============================================================================
# FRONTEND
# ============================================================================
VITE_API_URL=http://localhost:4000
VITE_API_GATEWAY_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_SENTRY_DSN=
VITE_APP_VERSION=2.6.0

# ============================================================================
# API GATEWAY
# ============================================================================
NODE_ENV=development
PORT=4000
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

# ============================================================================
# AGENT ORCHESTRATOR
# ============================================================================
AGENT_PORT=8000
BUFFER_WINDOW_MINUTES=30
DEFAULT_THRESHOLD_MIN=3

# ============================================================================
# GMAIL INBOUND EMAIL (Push Notifications via Pub/Sub)
# ============================================================================
# Required for receiving vendor email replies in real-time
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-notifications
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-gcp-project/subscriptions/gmail-push
GMAIL_WATCH_LABEL_IDS=INBOX

# ============================================================================
# MONITORING
# ============================================================================
LOG_LEVEL=debug
DEBUG=true

# ============================================================================
# YOLO PREVIEW MODEL
# ============================================================================
YOLO_MODEL_PATH=datasets/wine_menus_2class/runs/train2/weights/best.pt
