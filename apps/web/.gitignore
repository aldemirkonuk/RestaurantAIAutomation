# Logs — root-scoped (2026-09-11): an unscoped `logs` pattern silently
# swallowed apps/web/src/pages/logs/ (the /logs page rebuild) because
# gitignore patterns without a leading slash match at any depth. No build
# tool here ever wrote a top-level apps/web/logs/, so root-scoping loses
# nothing and stops a page directory from vanishing from `git status`.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.local
.env.production

# Playwright artifacts — excluded per T-14-06 (traces/screenshots contain local dev data)
test-results/
playwright-report/

.vercel
