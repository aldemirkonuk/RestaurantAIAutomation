# =============================================================================
# WineOps monorepo — root ignores (sub-apps have their own .gitignore too)
# =============================================================================

# Secrets — never commit real credentials
.env
.env.*
!.env.example
.env.local
.env.*.local

# Google service-account keys. A real one (wineops-vertex-ai-*.json) sat
# untracked at the repo root on 2026-08-26 with no rule matching it, in a
# checkout several sessions share — one `git add -A` would have published a
# private key to a PUBLIC repository. It never entered history (checked across
# all refs), so nothing leaked; this closes the door before it does.
# Patterns rather than one filename, because the next key will be named
# something else.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*service-account*.json
*serviceaccount*.json
*-credentials.json
gcp-*.json
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# Dependencies
#
# NO TRAILING SLASH, deliberately. `node_modules/` matches DIRECTORIES ONLY — a
# SYMLINK named node_modules walks straight past it. On 2026-08-27 exactly that
# happened: a worktree symlink pointing at an absolute path on one laptop was
# committed to main, and every CI `pnpm install` died with
# `ENOENT ... mkdir '.../apps/api-gateway/node_modules'` because pnpm cannot
# create the real directory over a dangling link. Two jobs red on main until it
# was removed.
node_modules

# Python (root-level scripts, datasets tooling)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Build / caches
.turbo/
dist/
.next/
*.log
logs/
# ...but not source directories that happen to be called "logs". The bare
# pattern above was written for runtime log output (services/agent-orchestrator/logs)
# and silently swallowed apps/api-gateway/src/logs — a real NestJS module that
# git therefore never saw. Source that cannot be committed cannot be deployed,
# and nothing surfaces that until something downstream is mysteriously absent.
!apps/api-gateway/src/logs/

# Vercel CLI project link (machine-local, generated by `vercel link`)
.vercel

# OS / editors
.DS_Store
Thumbs.db
.idea/

# Supabase CLI temp
supabase/.temp/

# Large local model weights (keep out of git unless you intend to LFS)
*.pt
*.pth
*.onnx
*.bin

# IDE / local tooling (never ship to CI or production images from git)
.cursor/

# Large third-party or scraped dataset trees (keep scripts + small samples only)
External_Wine_Datasets/
datasets/annotation_images/
datasets/annotation_inbox/
# Generated document packs (scripts.docgen). Every artifact is reproducible
# from its seed via `python3 -m scripts.docgen generate`, so the bytes are
# derived data, not source. The generator and its templates ARE tracked.
datasets/sim/documents/
datasets/wine_menus/images/
datasets/wine_menus/runs/
datasets/wine_menus/labels/*.cache
datasets/wine_menus_2class/

# Accidental duplicate filenames (editor copies)
* 2.py
* 2.md

# Merge / local backup files
README.md.local-backup
*.backup

# Binary office docs (use markdown in repo instead)
*.docx

# Local test output
services/agent-orchestrator/test-results/

# Vendored local tools (not part of app runtime)
vendor/

# Local ML / training run outputs at repo root
runs/

# Archived Cursor chat exports (huge, non-source)
md/Agent_Chat_History/
md_files/Agent_Chat_History/
md/**/*.png
md_files/**/*.png
cursor_chat_backup/
.planning/.Rhistory

# Railway IaC — CLI-installed agent skill and transient config-pull temp dirs
.agents/
.railway-config-pull-*/

# Obsidian workspace-local state (vault config itself IS committed)
.planning/.obsidian/workspace.json
.planning/.obsidian/workspace-mobile.json
.planning/.obsidian/cache/
.planning/.obsidian/plugins/*/data.json

# Ephemeral runner written by scripts/check_gateway_boots.sh
apps/api-gateway/.gateway-boot-check.cjs

# Generated OpenAPI spec — a command, not a commit (ADR 0123, OD-89).
# `pnpm --filter @wineops/api-gateway openapi:export` writes it; nothing in the
# repo reads it, and booting the gateway no longer touches it.
apps/api-gateway/openapi.json
