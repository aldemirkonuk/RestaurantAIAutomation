{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "50"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|mcp__.*[Mm]erge.*|mcp__.*(?:[Tt]erminal|[Ss]andbox|[Ee]xec|[Ss]hell|[Cc]omputer|[Ss]imulator|[Dd]irectory).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I $CLAUDE_PROJECT_DIR/scripts/hooks/require_pr_audit.py",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/jev/prompt_gate.py\" --for=claude || exit 0'",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
